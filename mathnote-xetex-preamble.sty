\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathnote-xetex-preamble}[2025/11/18 Math note XeLaTeX-only preamble wrapper]

% 引擎检查：仅允许 XeLaTeX
\RequirePackage{iftex}
\ifXeTeX
  % OK
\else
  \PackageError{mathnote-xetex-preamble}{本导言仅支持 XeLaTeX 编译}{请在 MikTeX / TeX Live 中选择 XeLaTeX 引擎重新编译。}
\fi

\makeatletter

% 复用原有 root 探测逻辑，避免重复配置
\newif\ifmathnote@rootfound
\mathnote@rootfoundfalse
\def\mathnote@rootpath{}
\newcommand*\MathNoteXe@TestRoot[1]{%
  \IfFileExists{#1mathnote-core.tex}{%
    \gdef\mathnote@rootpath{#1}%
    \mathnote@rootfoundtrue
  }{}%
}
\MathNoteXe@TestRoot{}
\ifmathnote@rootfound\else\MathNoteXe@TestRoot{../}\fi
\ifmathnote@rootfound\else\MathNoteXe@TestRoot{../../}\fi
\ifmathnote@rootfound\else\MathNoteXe@TestRoot{../../../}\fi
\ifmathnote@rootfound\else\MathNoteXe@TestRoot{../../../../}\fi
\ifmathnote@rootfound\else\MathNoteXe@TestRoot{../../../../../}\fi
\ifmathnote@rootfound\else
  \PackageError{mathnote-xetex-preamble}{mathnote-core.tex 未找到}{请确认 mathnote-* 导言文件与当前文档在同一工程目录树内。}
\fi
\newcommand*\MathNoteXeInputFromRoot[1]{%
  \input{\mathnote@rootpath#1}%
}

% 按原顺序加载核心模块
\MathNoteXeInputFromRoot{mathnote-core.tex}
\MathNoteXeInputFromRoot{mathnote-colors.tex}
\MathNoteXeInputFromRoot{mathnote-structure.tex}
\MathNoteXeInputFromRoot{mathnote-content.tex}

% 0. �汾��Ϣ��: ��ҳ���ڵȷ���ʾ "<noteversion> | <notedate>"
\providecommand{\noteversionmark}{}
\providecommand{\MathNoteVersionBlock}{%
  {\normalsize\color{inkgray}%
    \if\relax\detokenize{\noteversionmark}\relax
      \noteversion\quad|\quad\notedate
    \else
      \noteversionmark\\%
      \noteversion\quad|\quad\notedate
    \fi
    \par
  }%
}

% --- 颜色与盒子、列表细节的 Tweaks -------------------------

% 1. 打印模式切换时同时更新 tone01–tone16 调色板
% 原始 \MathNoteEnablePrint 在 mathnote-core.tex 中定义；
% 这里通过 \renewcommand 在 XeLaTeX 包装层统一改写。
\providecommand{\MathNoteEnablePrint}{}% 防止未定义时报错
\renewcommand{\MathNoteEnablePrint}{%
  \mathnoteprintmodetrue
  % 使用公开接口，确保语义色 + tone01–tone16 + hyperref 一起更新
  \MathNoteApplyPalette
}

% 2. listings 使用 toneXX 而不是硬编码 screenToneXX
% 覆盖 mathnote-content.tex 中的默认 \lstset 配置。
\AtBeginDocument{%
  \lstset{%
    keywordstyle=\color{tone04}\bfseries,
    commentstyle=\color{tone06},
    stringstyle=\color{tone12}%
  }%
}

% 3. 彩色盒子标题统一使用 *title 语义色
% 通过 tcolorboxenvironment 为现有环境追加/覆盖 coltitle 与 fonttitle。
\tcolorboxenvironment{definitionbox}{%
  coltitle=secondarytitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{theorembox}{%
  coltitle=accenttitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{examplebox}{%
  coltitle=highlighttitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{notebox}{%
  coltitle=highlighttitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{summarybox}{%
  coltitle=accenttitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{conceptbox}{%
  coltitle=secondarytitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{lemmabox}{%
  coltitle=inktitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{proofbox}{%
  coltitle=inktitle,
  fonttitle=\sffamily\bfseries
}
\tcolorboxenvironment{warningbox}{%
  coltitle=highlighttitle,
  fonttitle=\sffamily\bfseries
}

\makeatother

% 1.1 ��ҳü�м���ʾ�汾�ţ�<notetitle> (version) > section
\renewcommand{\MathNoteHeaderFormat}{%
  \small\sffamily
  \textcolor{accent}{\notetitle\ >\ \nouppercase{\rightmark}}%
}
